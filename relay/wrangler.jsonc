{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ritela-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {"AUTO_REGISTRATION": "true"},
  "ratelimits": [
    {"name": "RATE_LIMITER", "namespace_id": "1001", "simple": {"limit": 60, "period": 60}},
    {"name": "REGISTRATION_RATE_LIMITER", "namespace_id": "1002", "simple": {"limit": 3, "period": 60}}
  ],
  "observability": { "enabled": false },
  "d1_databases": [{
    "binding": "DB", "database_name": "ritela_db",
    "database_id": "133088c5-c0e6-40b7-b264-af6ef7d1cdd8",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["0 * * * *"] }
}
