<?xml version="1.0" encoding="utf-8"?>
<!-- Slightly overscan the visible 72/108 area so the artwork's transparent rim
     stays outside launcher masks. Keep the bird and orbit near their original size. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="10%">
    <bitmap
        android:src="@drawable/launcher_art"
        android:gravity="fill"
        android:filter="true" />
</inset>
